<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="May VPS Deploy" Width="1180" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#1e222a" Foreground="#e8ebef"
        FontSize="13" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#a9cde2"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#606773" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="10"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#e8ebef"/><Setter Property="Background" Value="#343942"/>
      <Setter Property="BorderBrush" Value="#464c56"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="10" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsRow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="20,17"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#15232f"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Navigation" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#c2c7d0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Frame" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="Transparent">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#2b3039"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="#2b3744"/><Setter Property="Foreground" Value="#c5dfef"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#282d37"/><Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="#3b414c"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1e222a"/><Setter Property="Foreground" Value="#e8ebef"/>
      <Setter Property="CaretBrush" Value="#e8ebef"/><Setter Property="BorderBrush" Value="#4b4b4b"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#1e222a"/><Setter Property="Foreground" Value="#e8ebef"/>
      <Setter Property="CaretBrush" Value="#e8ebef"/><Setter Property="BorderBrush" Value="#4b4b4b"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#e8ebef"/><Setter Property="Background" Value="#343942"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#343942" BorderBrush="#464c56" BorderThickness="1" CornerRadius="8" Padding="12,10"><Grid><TextBlock Text="⌄" HorizontalAlignment="Right"/></Grid></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton><ContentPresenter Margin="12,10,30,10" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="#282d37" BorderBrush="#464c56" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border>
        </Popup></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#e8ebef"/><Setter Property="Padding" Value="12,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#3b4654"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Width="40" Height="24">
          <Border x:Name="Track" Background="#555555" CornerRadius="12"/>
          <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" Margin="3" HorizontalAlignment="Left"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
          <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#e8ebef"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Frame" Background="#222730" BorderBrush="#464c56" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#343942"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#2b3744"/><Setter TargetName="Frame" Property="BorderBrush" Value="#a9cde2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#aeaeae"/><Setter Property="Margin" Value="0,14,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
        <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" HorizontalContentAlignment="Left">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><DockPanel><TextBlock x:Name="Chevron" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="10" Width="20" VerticalAlignment="Center"/><ContentPresenter/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        </ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed" Content="{TemplateBinding Content}"/>
      </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="8" BorderThickness="1" BorderBrush="#3b414c">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8"><GradientStop Color="#1b2435" Offset="0"/><GradientStop Color="#1e2025" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#1d2026" BorderBrush="#343942" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,26,14,16">
          <StackPanel DockPanel.Dock="Top" Margin="10,0,0,22">
            <TextBlock x:Name="Brand" Text="May Deploy" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionLabel" Text="0.7.0" Foreground="#828282" Margin="0,7,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="12,10,0,0">
            <TextBlock Text="Windows 控制端" Foreground="#777777" FontSize="11"/>
            <TextBlock x:Name="SidebarStatus" Text="准备就绪" Foreground="#7ab7a0" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel>
            <RadioButton x:Name="NavOverview" GroupName="Navigation" Style="{StaticResource Navigation}" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" Width="28" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="概述"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavInstances" GroupName="Navigation" Style="{StaticResource Navigation}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8F1;" Width="28" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="实例"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavDeploy" GroupName="Navigation" Style="{StaticResource Navigation}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" Width="28" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="部署"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavClients" GroupName="Navigation" Style="{StaticResource Navigation}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" Width="28" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="客户端"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavRecords" GroupName="Navigation" Style="{StaticResource Navigation}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" Width="28" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="记录"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavSettings" GroupName="Navigation" Style="{StaticResource Navigation}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Width="28" FontSize="16" VerticalAlignment="Center"/><TextBlock Text="设置"/></StackPanel></RadioButton>
            <Button x:Name="ActiveTask" Content="返回当前任务" HorizontalContentAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border x:Name="TitleBar" Background="#1d2026" BorderBrush="#343942" BorderThickness="0,0,0,1">
          <DockPanel Margin="24,0,10,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="MinimizeWindow" Content="─" Background="Transparent" BorderThickness="0" Padding="16,6"/>
              <Button x:Name="MaximizeWindow" Content="□" Background="Transparent" BorderThickness="0" Padding="16,6"/>
              <Button x:Name="CloseWindow" Content="×" Background="Transparent" BorderThickness="0" Padding="16,6" FontSize="19"/>
            </StackPanel>
            <TextBlock x:Name="PageTitle" Text="概述" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="PageContainer" Margin="32,30,32,24">
            <StackPanel x:Name="OverviewPage">
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel><TextBlock Text="受管实例" FontWeight="SemiBold" Foreground="#c2c7d0"/>
                    <TextBlock x:Name="InstanceCount" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <TextBlock Text="来自本地归档" Foreground="#a6afbb"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel><TextBlock Text="本地环境" FontWeight="SemiBold" Foreground="#c2c7d0"/>
                    <TextBlock x:Name="RuntimeLabel" Text="PowerShell 7.4+" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,7"/>
                    <TextBlock x:Name="EnvironmentLabel" Text="Windows · 准备就绪" Foreground="#7ab7a0"/>
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="常用操作" Foreground="#939eae" Margin="4,4,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0"><StackPanel><TextBlock Text="部署与接入" FontSize="16" FontWeight="SemiBold" Margin="20,20,20,8"/><Button x:Name="TaskNew" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="部署新 VPS" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="建立新计划、SSH 与代理" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button><Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="TaskImport" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B5;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="接入已有 VPS" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="保留原有服务，建立管理记录" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button><Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="TaskResume" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="继续未完成部署" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="从已有部署计划继续" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button></StackPanel></Border><Grid Grid.Column="2"><Border Style="{StaticResource Card}" Padding="0"><StackPanel><TextBlock Text="维护与配置" FontSize="16" FontWeight="SemiBold" Margin="20,20,20,8"/><Button x:Name="TaskProtocols" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D4;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="代理协议" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="安装、启停和切换协议" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button><Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="TaskMaintain" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE90F;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="运维中心" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="服务检查、恢复与组件维护" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button><Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="TaskClients" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="客户端配置" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="管理方案与两端配置" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button></StackPanel></Border></Grid>
              </Grid>
              <Grid Margin="0,18,0,0"><Border Style="{StaticResource Card}" Padding="0"><StackPanel><TextBlock Text="工具" FontSize="16" FontWeight="SemiBold" Margin="20,20,20,8"/><Button x:Name="TaskNetwork" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE968;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="调整网络参数" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="根据带宽与往返延迟保守调整" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button><Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="TaskValidate" Style="{StaticResource SettingsRow}"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
 <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="19" VerticalAlignment="Center" Foreground="#c2ceda"/>
 <StackPanel Grid.Column="1"><TextBlock Text="本地自检" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="检查脚本和离线测试" Foreground="#a6afbb" FontSize="11" Margin="0,6,10,0"/></StackPanel>
 <TextBlock Grid.Column="2" FontFamily="Segoe Fluent Icons" Text="&#xE76C;" VerticalAlignment="Center" Foreground="#9aa7b5" FontSize="12"/>
 </Grid></Button></StackPanel></Border></Grid>
            </StackPanel>
            <StackPanel x:Name="DeploymentPage" Visibility="Collapsed">
              <TextBlock x:Name="DeploymentCaption" Text="部署新 VPS" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="基础信息 → 配置选项 → 审阅 → 执行" Foreground="#a6afbb" Margin="0,10,0,24"/>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="实例信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="服务商" Margin="0,0,0,8"/><TextBox x:Name="NewProvider"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="实例名称" Margin="0,0,0,8"/><TextBox x:Name="NewInstance"/></StackPanel>
                </Grid>
                <TextBlock Text="客户端节点名称（可留空自动生成）" Margin="0,18,0,8"/><TextBox x:Name="NewNodeName"/>
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="服务器 IPv4" Margin="0,0,0,8"/><TextBox x:Name="NewIPv4"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="服务器 IPv6（可选）" Margin="0,0,0,8"/><TextBox x:Name="NewIPv6"/></StackPanel>
                </Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel>
                <TextBlock Text="SSH 连接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="当前 root SSH 端口" Margin="0,0,0,8"/><TextBox x:Name="NewSshPort" Text="22"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="认证方式" Margin="0,0,0,8"/><ComboBox x:Name="NewAuthType" SelectedIndex="0"><ComboBoxItem Content="现有 OpenSSH 私钥"/><ComboBoxItem Content="密码"/></ComboBox></StackPanel>
                </Grid>
                <StackPanel x:Name="NewKeyFields" Margin="0,18,0,0"><TextBlock Text="现有私钥" Margin="0,0,0,8"/><DockPanel><Button x:Name="BrowseNewKey" DockPanel.Dock="Right" Content="浏览…" Margin="10,0,0,0"/><TextBox x:Name="NewKeyPath"/></DockPanel>
                  <TextBlock Text="管理密钥" Margin="0,18,0,8"/><ComboBox x:Name="NewKeyMode" SelectedIndex="0"><ComboBoxItem Content="复用现有私钥"/><ComboBoxItem Content="生成新的管理密钥，保留现有密钥"/></ComboBox>
                </StackPanel>
                <TextBlock x:Name="NewAuthNote" Text="认证凭据会在连接时通过隐藏输入框询问。" Foreground="#a6afbb" Visibility="Collapsed" Margin="0,16,0,0"/>
              </StackPanel></Border>
              <Border x:Name="NewRoleFields" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel>
                <TextBlock Text="部署用途" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <ComboBox x:Name="NewRole" SelectedIndex="0"><ComboBoxItem Content="Reality 入口"/><ComboBoxItem Content="AnyTLS + ECH 入口"/><ComboBoxItem Content="Shadowsocks 2022 落地"/><ComboBoxItem Content="仅 SSH、防火墙与监控"/><ComboBoxItem Content="仅建立管理入口并审计"/></ComboBox>
                <TextBlock Text="日常管理用户" Margin="0,18,0,8"/><TextBox x:Name="NewAdmin" Text="admin"/>
              </StackPanel></Border>
              <TextBlock x:Name="NewFormError" Foreground="#f0b5ac" Margin="4,18,0,0" Visibility="Collapsed"/>
              <Button x:Name="StartNewForm" Content="配置下一步" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ClientsPage" Visibility="Collapsed">
              <TextBlock Text="客户端配置" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="编辑方案 → 生成候选 → 校验 → 发布" Foreground="#a6afbb" Margin="0,10,0,24"/>
              <Border Style="{StaticResource Card}" Padding="0"><StackPanel>
                <Button x:Name="ClientCreate" Style="{StaticResource SettingsRow}" Content="创建新方案" HorizontalContentAlignment="Left"/>
                <Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="ClientOpen" Style="{StaticResource SettingsRow}" Content="打开已保存的方案" HorizontalContentAlignment="Left"/>
                <Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="ClientFromConfig" Style="{StaticResource SettingsRow}" Content="从现有 Clash / sing-box 配置创建方案" HorizontalContentAlignment="Left"/>
                <Border BorderBrush="#343b47" BorderThickness="0,1,0,0"/><Button x:Name="ClientValidate" Style="{StaticResource SettingsRow}" Content="校验现有配置" HorizontalContentAlignment="Left"/>
              </StackPanel></Border>
              <Expander Header="高级"><StackPanel Margin="0,12,0,0"><Button x:Name="ClientDefaults" Content="默认配置偏好" HorizontalAlignment="Left"/><Button x:Name="ClientRecover" Content="恢复未完成的发布" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander>
              <Button x:Name="CloseClientWorkspace" Content="结束本次配置" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,22,0,0"/>
            </StackPanel>
            <StackPanel x:Name="InstancesPage" Visibility="Collapsed">
              <TextBlock Text="本地实例归档" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="选择实例后进行管理。这里显示归档信息，执行检查后再确认服务器状态。" Foreground="#adb5c1" Margin="0,10,0,24"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,16">
                    <TextBlock x:Name="InstanceRootLabel" Text="归档保存在应用目录" Foreground="#adb5c1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  </DockPanel>
                  <ListBox x:Name="InstanceList" MinHeight="120" MaxHeight="350"/>
                  <TextBlock x:Name="NoInstancesLabel" Text="此目录暂无受管计划，可先接入已有 VPS。" Foreground="#a6afbb" Margin="0,12,0,0"/>
                  <TextBlock x:Name="SelectedInstanceLabel" Text="尚未选择实例" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"/>
                  <TextBlock x:Name="SelectedInstanceDetails" Text="选中实例后查看归档信息。" Foreground="#a6afbb" Margin="0,10,0,0"/>
                  <WrapPanel Margin="0,18,0,0">
                    <Button x:Name="InstanceMaintain" Content="运维中心" Style="{StaticResource Primary}" Margin="0,0,10,8"/>
                    <Button x:Name="InstanceProtocols" Content="代理协议" Margin="0,0,10,8"/>
                    <Button x:Name="InstanceResume" Content="继续部署" Margin="0,0,10,8"/>
                    <Button x:Name="InstanceNetwork" Content="网络参数" Margin="0,0,0,8"/>
                  </WrapPanel>
                  <Button x:Name="ContinueSelected" Content="选择实例并继续" Style="{StaticResource Primary}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="WorkflowPage" Visibility="Collapsed">
              <TextBlock x:Name="WorkflowTitle" Text="当前任务" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock x:Name="WorkflowTarget" Foreground="#a9cde2" Margin="0,10,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="WorkflowStatus" Text="正在准备…" Foreground="#adb5c1" Margin="0,10,0,22"/>
              <TextBlock x:Name="WorkflowStage" Text="配置选项 → 审阅 → 执行" Foreground="#a9cde2" Visibility="Collapsed" Margin="0,0,0,18"/>
              <ProgressBar x:Name="TaskProgress" Height="3" Foreground="#a9cde2" Background="#343942" IsIndeterminate="True" Margin="0,0,0,20"/>
              <Border x:Name="InputCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="QuestionLabel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                  <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"><TextBlock x:Name="QuestionContext" Foreground="#b5b5b5"/></ScrollViewer>
                  <ListBox x:Name="ChoiceList" MaxHeight="360" Visibility="Collapsed"/>
                  <StackPanel x:Name="ChoiceActions" Visibility="Collapsed"/>
                  <TextBox x:Name="TextInput" Visibility="Collapsed"/>
                  <PasswordBox x:Name="SecretInput" Visibility="Collapsed"/>
                  <Button x:Name="PickInputPath" Content="浏览…" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
                  <TextBlock x:Name="InputHint" Foreground="#a6afbb" Margin="0,10,0,0"/>
                  <Expander x:Name="InputHelp" Header="说明"><TextBlock x:Name="HelpText" Margin="8,12" Foreground="#bbbbbb"/></Expander>
                  <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="SubmitInput" Content="继续" Style="{StaticResource Primary}" MinWidth="100"/>
                    <Button x:Name="BackInput" Grid.Column="1" Content="上一步" Margin="10,0,0,0"/>
                    <Button x:Name="ClearInput" Grid.Column="3" Content="清空此项" Visibility="Collapsed"/>
                  </Grid>
                </StackPanel>
              </Border>
              <StackPanel x:Name="CompletedActions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                <Button x:Name="ReturnOverview" Content="返回概述" Style="{StaticResource Primary}"/>
              </StackPanel>
              <Expander Header="执行详情" x:Name="TaskDetails">
                <TextBox x:Name="WorkflowLog" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" FontSize="12"/>
              </Expander>
              <Button x:Name="CancelTask" Content="取消当前任务" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#adb5c1" Margin="0,16,0,0"/>
            </StackPanel>
            <StackPanel x:Name="RecordsPage" Visibility="Collapsed">
              <TextBlock Text="执行记录" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
              <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="近期任务" FontWeight="SemiBold" Margin="0,0,0,14"/><ListBox x:Name="TaskHistory" MaxHeight="240"/><TextBlock x:Name="NoTaskHistory" Text="暂无任务记录。" Foreground="#a6afbb"/></StackPanel></Border>
              <TextBlock Text="本次窗口的执行详情" Foreground="#a6afbb" Margin="0,0,0,12"/>
              <Border Style="{StaticResource Card}"><TextBox x:Name="RecordsLog" IsReadOnly="True" TextWrapping="Wrap" MinHeight="300" MaxHeight="550" VerticalScrollBarVisibility="Auto" Text="暂无执行记录。"/></Border>
            </StackPanel>
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
              <TextBlock Text="应用" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,22"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="外观" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="深色 · 蓝灰" Foreground="#a6afbb"/>
                  </Grid>
                  <Border BorderBrush="#3b414c" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="界面大小" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ScaleNormal" Content="标准" Padding="12,6"/><Button x:Name="ScaleLarge" Content="大" Padding="12,6" Margin="8,0,0,0"/></StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Text="更新" Foreground="#939eae" Margin="4,24,0,12"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="自动检查更新" VerticalAlignment="Center"/><CheckBox x:Name="AutoUpdateCheck" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                  </Grid>
                  <Border BorderBrush="#3b414c" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                    <StackPanel>
                      <DockPanel><Button x:Name="CheckUpdate" DockPanel.Dock="Right" Content="检查更新" Padding="14,8"/><TextBlock x:Name="UpdateVersion" Text="当前版本 0.7.0" VerticalAlignment="Center"/></DockPanel>
                      <TextBlock x:Name="UpdateStatus" Text="尚未检查" Foreground="#a6afbb" Margin="0,12,0,0"/>
                      <Expander x:Name="ReleaseNotes" Header="更新说明" Visibility="Collapsed"><TextBlock x:Name="ReleaseNotesText" Margin="8,12" MaxHeight="240"/></Expander>
                      <Button x:Name="ApplyUpdate" Content="更新并重启" Style="{StaticResource Primary}" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,16,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Expander Header="网络代理（可选）"><TextBox x:Name="UpdateProxy" Margin="0,12,0,0" ToolTip="填写本机 HTTP 代理，例如 http://127.0.0.1:端口；仅用于应用更新。"/></Expander>
              <Expander Header="数据位置"><TextBlock x:Name="DataLocation" Foreground="#a6afbb" Margin="0,12,0,0"/></Expander>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#343942" BorderThickness="0,1,0,0">
          <DockPanel Margin="24,0"><TextBlock x:Name="FooterStatus" Text="准备就绪" Foreground="#939eae" FontSize="11" VerticalAlignment="Center"/></DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
